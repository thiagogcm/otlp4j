<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.nthings.otlp4j</groupId>
        <artifactId>otlp4j-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>otlp4j-testing</artifactId>
    <name>otlp4j-testing</name>
    <description>Shared test fixtures and utilities consumed by the other otlp4j reactor modules in
        test scope. Typed factory methods for the dev.nthings.otlp4j.model vocabulary, so every
        module builds its small OTLP objects from one place. Depend on it with scope=test; this
        module ships no production behaviour and is not part of any module's runtime surface.</description>

    <!-- The fixtures speak only in dev.nthings.otlp4j.model terms (no api, no proto, no logging
         facade), so this is the single non-optional compile dependency. The conformance harness
         under dev.nthings.otlp4j.testing.conformance adds the further compile dependencies below,
         all marked optional so they do not propagate to the many modules that consume this jar in
         test scope and never touch the harness. Optional here is load-bearing: a downstream test
         build must not gain Netty transitively, and a model test build must not gain proto or gRPC
         transitively. The declaring module still compiles the harness against them.
         This module has no module-info.java and must keep it that way: it stays on the classpath so
         the harness can read otlp4j-proto's packages, which the proto module exports only qualified
         to the codec and the consolidated transport. -->
    <dependencies>
        <dependency>
            <groupId>dev.nthings.otlp4j</groupId>
            <artifactId>otlp4j-model</artifactId>
        </dependency>

        <!-- The policy semantics suite under dev.nthings.otlp4j.testing.policy names the neutral
             RetryPolicy, BackoffPolicy, and TimeoutPolicy records directly, so it compiles against
             core. Optional, like the junit/assertj/awaitility deps below, because the suite classes
             are exercised only in the declaring module and in otlp4j-conformance, which declares core
             itself; core stays off the many model/api test builds that consume this jar and never
             touch the suite. Acyclic: core depends only on model, so testing stays upstream of the
             transports. -->
        <dependency>
            <groupId>dev.nthings.otlp4j</groupId>
            <artifactId>otlp4j-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- The wire clients build OTLP request/response protos with the generated builders and
             drive the generated blocking stubs directly, so they name proto and gRPC types. -->
        <dependency>
            <groupId>dev.nthings.otlp4j</groupId>
            <artifactId>otlp4j-proto</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- grpc-netty supplies the NameResolver/LoadBalancer providers the channel needs at
             runtime for a host:port target; compile-visible so the harness stays self-contained. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- The abstract JUnit suites and the AssertJ/Awaitility assertions live in src/main so a
             concrete runner in otlp4j-conformance can subclass them; the test-scope inheritance
             from the parent is not visible to main sources, hence these optional compile deps. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <!-- No build plugins of our own: parent already wires flatten, the doclint compile pass, the
         maven-javadoc-plugin lint, and the inherited JaCoCo prepare-agent/report (which no-op
         here since the module has no tests of its own — its classes are exercised through
         consumer test suites). No check-coverage execution: opting in to the 90/80 floor would
         require either fixture-coverage tests or per-class excludes, both wasteful. -->

</project>
