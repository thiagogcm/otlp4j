<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.nthings.otlp4j</groupId>
        <artifactId>otlp4j-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>otlp4j-transport-common</artifactId>
    <name>otlp4j-transport-common</name>
    <description>Shared transport layer for the bundled OTLP transports: the ClientExporter /
        ServerReceiver composition primitives (each wrapping an OtlpClient / OtlpServer) and the
        receiver-side dispatch and tap plumbing. JPMS module dev.nthings.otlp4j.transport.common, a
        low-level layer below the OtlpGrpc* / OtlpHttp* entry points.</description>

    <dependencies>
        <!-- The domain batch records the receiver tap and the transport SPI carry. -->
        <dependency>
            <groupId>dev.nthings.otlp4j</groupId>
            <artifactId>otlp4j-model</artifactId>
        </dependency>
        <!-- The relocated config records carry the neutral core policies, and the component
             adapters and the receiver and exporter component configs name core component,
             consumer, result, and signal types directly. -->
        <dependency>
            <groupId>dev.nthings.otlp4j</groupId>
            <artifactId>otlp4j-core</artifactId>
        </dependency>
        <!-- The codec payload facade (Payloads) the exporter facet and the convenience export build;
             its public payload surface names only core types, so no proto leaks onto this module. -->
        <dependency>
            <groupId>dev.nthings.otlp4j</groupId>
            <artifactId>otlp4j-codec</artifactId>
        </dependency>
        <!-- Resilience4j is the internal retry engine the neutral RetryPolicy translates to; it used
             to arrive transitively through api, which no longer re-exports it. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
        </dependency>
        <!-- Logging facade only; no backend bound here. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Shared OTLP test fixtures (Fixtures, FlowSubscribers). -->
        <dependency>
            <groupId>dev.nthings.otlp4j</groupId>
            <artifactId>otlp4j-testing</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Opt in to the shared coverage floor (parent POM). The shared exporter/receiver impls
                 and the ReceiverTap fan-out need a concrete transport to exercise (covered by the
                 transport suites and aggregate), so they're excluded; MulticastPublisher/SignalSource
                 are floored by this module's own suites. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>dev/nthings/otlp4j/transport/common/ClientExporter*</exclude>
                                <exclude>dev/nthings/otlp4j/transport/common/ServerReceiver*</exclude>
                                <exclude>dev/nthings/otlp4j/transport/common/ReceiverTap*</exclude>
                                <!-- SPI contracts relocated from api; interfaces need a concrete
                                     transport to exercise (covered by the transport suites and the
                                     aggregate), as api excluded them before the move. -->
                                <exclude>dev/nthings/otlp4j/spi/*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
